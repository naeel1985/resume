# This is a flat single-app repo with no npm workspaces.
#
# cPanel/CloudLinux's Node Selector can carry a stale `workspaces=true` in the
# per-app nodevenv npmrc, which forces every `npm install` into workspace mode
# and fails with "No workspaces found!". This project-level setting overrides
# that. (Same guard as the costtrack project — remove it if you never hit that.)
workspaces=false
