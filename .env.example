# Copy to .env.local (dev) or set as cPanel Node.js App environment variables (prod).
# Never commit the filled-in file.

# ---- Claude ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ---- SMTP (transcript delivery) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@example.com"
SMTP_PASS="gmail-app-password"
MAIL_FROM="Naeel Zuriek <you@example.com>"
MAIL_TO="you@example.com"

# ---- Site ----
# Used for CSRF-ish origin checks on the chat API. Comma-separated.
ALLOWED_ORIGINS="https://naeel.ai-technology.ae"

# Minutes of inactivity before a transcript is emailed automatically.
TRANSCRIPT_IDLE_MINUTES="60"

# Optional: shared secret so an external cron can force a sweep.
# GET /api/transcripts/sweep with header `x-sweep-token: <value>`
SWEEP_TOKEN=""

# HMAC key for the visitor cookie the 30-question quota is tracked against.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random key is generated per process, so visitor lockouts reset
# whenever the app restarts.
QUOTA_COOKIE_SECRET=""
